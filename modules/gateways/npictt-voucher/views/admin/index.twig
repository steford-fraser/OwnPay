{% extends 'admin/layout/base.twig' %}
{% block title %}Vouchers - {{ app_name }}{% endblock %}
{% block content %}

<div class="op-page-header">
    <div>
        <h1>Vouchers</h1>
        <p class="op-page-subtitle">Prepaid vouchers shared by every brand. Payers enter one or more codes at checkout and the balance is deducted.</p>
    </div>
    <div class="op-header-actions">
        {% for cur, total in outstanding %}
        <span class="op-badge op-badge-success">{{ cur }} {{ total|number_format(2) }} outstanding</span>
        {% endfor %}
        <span class="op-text-muted op-text-sm">{{ pagination.total_items ?? 0 }} vouchers</span>
    </div>
</div>

{% if can_issue %}
<div class="op-card op-mb-4">
    <div class="op-card-body">
        <form method="POST" action="/admin/gateways/vouchers/issue" class="op-advanced-filters">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">
            <div class="op-filter-field">
                <label class="op-text-sm op-text-muted" for="vp-count">How many</label>
                <input id="vp-count" type="number" name="count" min="1" max="100" value="5" class="op-input op-input-sm" required>
            </div>
            <div class="op-filter-field">
                <label class="op-text-sm op-text-muted" for="vp-amount">Amount each</label>
                <input id="vp-amount" type="text" name="amount" inputmode="decimal" placeholder="100.00" class="op-input op-input-sm" required>
            </div>
            <div class="op-filter-field">
                <label class="op-text-sm op-text-muted" for="vp-currency">Currency</label>
                <input id="vp-currency" type="text" name="currency" value="TTD" maxlength="3" class="op-input op-input-sm" required>
            </div>
            <div class="op-filter-field">
                <label class="op-text-sm op-text-muted" for="vp-expires">Expires (optional)</label>
                <input id="vp-expires" type="date" name="expires_at" class="op-input op-input-sm">
            </div>
            <button type="submit" class="op-btn op-btn-primary">Issue vouchers</button>
        </form>
    </div>
</div>
{% else %}
<div class="op-alert op-alert-info op-mb-4">Switch to "All Brands" to issue new vouchers.</div>
{% endif %}

{# -- Status chips ------------------------------------------------ #}
<div class="op-filter-chips-row op-mb-3">
    {% set statuses = [
        {key: '', label: 'All'},
        {key: 'active', label: 'Active'},
        {key: 'used', label: 'Used up'},
        {key: 'expired', label: 'Expired'},
        {key: 'void', label: 'Void'},
    ] %}
    {% for s in statuses %}
    <a href="?status={{ s.key }}&q={{ filters.q|default('')|url_encode }}"
       class="op-chip {{ (filters.status|default('')) == s.key ? 'op-chip-active' : '' }}
              {% if s.key == 'active' %}op-chip-success{% elseif s.key == 'expired' %}op-chip-warning{% elseif s.key == 'void' or s.key == 'used' %}op-chip-danger{% endif %}">
        {{ s.label }}
    </a>
    {% endfor %}
</div>

{# -- Search ------------------------------------------------------ #}
<div class="op-card op-mb-4">
    <div class="op-card-body">
        <form method="GET" class="op-advanced-filters" id="voucher-filter-form">
            <input type="hidden" name="status" value="{{ filters.status|default('') }}">
            <div class="op-filter-field op-flex-1">
                <div class="op-filter-search-wrap">
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
                    <input type="search" name="q" value="{{ filters.q|default('') }}" placeholder="Search code or currency…" class="op-input op-input-sm op-search-input">
                </div>
            </div>
            <button type="submit" class="op-filter-btn">
                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/></svg>
                Filter
            </button>
            {% if filters.q or filters.status %}
            <a href="/admin/gateways/vouchers" class="op-filter-btn">✕ Clear</a>
            {% endif %}
        </form>
    </div>
</div>

<div class="op-card">
    <div class="op-card-body op-p-0">
        <div class="op-table-responsive">
            <table class="op-table">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Currency</th>
                        <th>Initial</th>
                        <th>Balance</th>
                        <th>Status</th>
                        <th>Used</th>
                        <th>Expires</th>
                        <th>Created</th>
                    </tr>
                </thead>
                <tbody>
                    {% for v in vouchers %}
                    {% set expired = v.expires_at and v.expires_at < now %}
                    <tr>
                        <td data-label="Code"><span class="op-text-monospace">{{ v.code }}</span></td>
                        <td data-label="Currency">{{ v.currency }}</td>
                        <td data-label="Initial">{{ v.initial_balance|number_format(2) }}</td>
                        <td data-label="Balance"><strong>{{ v.balance|number_format(2) }}</strong></td>
                        <td data-label="Status">
                            {% if v.status != 'active' %}
                            <span class="op-badge op-badge-danger">Void</span>
                            {% elseif expired %}
                            <span class="op-badge op-badge-warning">Expired</span>
                            {% elseif v.balance <= 0 %}
                            <span class="op-badge">Used up</span>
                            {% else %}
                            <span class="op-badge op-badge-success">Active</span>
                            {% endif %}
                        </td>
                        <td data-label="Used">{{ v.used_count }}</td>
                        <td data-label="Expires" class="op-text-muted op-text-sm">{{ v.expires_at ? v.expires_at|date('M d, Y') : '-' }}</td>
                        <td data-label="Created" class="op-text-muted op-text-sm">{{ v.created_at|date('M d, Y H:i') }}</td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="8" class="op-empty">No vouchers match the current filters.</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

{% if pagination is defined and pagination.total_pages > 1 %}
{% set qs = '' %}
{% if filters.q is not empty %}{% set qs = qs ~ '&q=' ~ filters.q|url_encode %}{% endif %}
{% if filters.status is not empty %}{% set qs = qs ~ '&status=' ~ filters.status|url_encode %}{% endif %}
<nav class="op-pagination op-mt-4">
    {% if pagination.has_prev %}<a href="?page={{ pagination.page - 1 }}{{ qs }}" class="op-page-link">← Prev</a>{% endif %}
    <span class="op-page-info">Page {{ pagination.page }} of {{ pagination.total_pages }} ({{ pagination.total_items }} total)</span>
    {% if pagination.has_next %}<a href="?page={{ pagination.page + 1 }}{{ qs }}" class="op-page-link">Next →</a>{% endif %}
</nav>
{% endif %}

{% endblock %}
