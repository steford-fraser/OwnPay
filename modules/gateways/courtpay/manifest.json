{
  "name": "CourtPay",
  "slug": "courtpay",
  "version": "1.0.0",
  "description": "CourtPay - the Judiciary of Trinidad and Tobago's payment portal (demo): court fines and fees by card, and CourtPay Top-up Vouchers.",
  "author": "Judiciary of Trinidad and Tobago",
  "type": "gateway",
  "category": "global",
  "icon": "assets/icon.svg",
  "color": "#076AAB",
  "entrypoint": "CourtPayGateway.php",
  "namespace": "OwnPay\\Modules\\Gateways\\Courtpay",
  "capabilities": ["gateway"],
  "requires": {
    "core": ">=0.1.0",
    "php": ">=8.1"
  },
  "routes": [
    ["GET", "/checkout/courtpay/{trx}/page", "page"],
    ["POST", "/checkout/courtpay/{trx}/identify", "identify"],
    ["POST", "/checkout/courtpay/{trx}/signup", "signup"],
    ["POST", "/checkout/courtpay/{trx}/verify", "verifyCode"],
    ["POST", "/checkout/courtpay/{trx}/identify/reset", "identifyReset"],
    ["POST", "/checkout/courtpay/{trx}/card", "card"],
    ["GET", "/checkout/courtpay/{trx}/3ds", "threeDs"],
    ["POST", "/checkout/courtpay/{trx}/3ds", "threeDs"],
    ["POST", "/checkout/courtpay/{trx}/return", "merchantResponse"],
    ["POST", "/checkout/courtpay/{trx}/voucher/apply", "voucherApply"],
    ["POST", "/checkout/courtpay/{trx}/voucher/remove", "voucherRemove"],
    ["POST", "/checkout/courtpay/{trx}/voucher/confirm", "voucherConfirm"],
    ["GET", "/checkout/courtpay/{trx}/cancel", "cancel"]
  ],
  "permissions": ["gateway.process"]
}
