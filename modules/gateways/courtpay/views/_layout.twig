<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title>{% block title %}CourtPay{% endblock %} - Payment Portal of the Judiciary of Trinidad and Tobago</title>
    <link rel="icon" href="{{ brand.mark }}">
    <style>
        :root { --cp-red: #BF3227; --cp-blue: #076AAB; --cp-navy: #084C79; --cp-grey: #919395; --cp-ink: #0f172a; --cp-muted: #64748b; --cp-line: #e2e8f0; --cp-ok: #047857; --cp-merchant: {{ merchant.color }}; }
        * { box-sizing: border-box; }
        body { margin: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; background: #f3f6f9; color: var(--cp-ink); }
        .cp-top { background: #fff; padding: 12px 20px; display: flex; align-items: center; justify-content: space-between; gap: 12px; box-shadow: 0 1px 0 var(--cp-line); }
        .cp-top img { height: 40px; width: auto; }
        .cp-tag { font-size: 12px; color: var(--cp-muted); text-align: right; line-height: 1.4; }
        .cp-tag strong { color: var(--cp-navy); }
        .cp-band { height: 5px; background: linear-gradient(90deg, var(--cp-red) 0 50%, var(--cp-blue) 50%); }
        .cp-hero { background: var(--cp-navy); color: #fff; padding: 14px 20px; font-size: 14px; }
        .cp-hero strong { font-size: 16px; }
        @media (max-width: 600px) { .cp-tag { display: none; } }
        .cp-wrap { max-width: 940px; margin: 26px auto; padding: 0 16px; display: grid; grid-template-columns: 1fr 1.35fr; gap: 22px; }
        .cp-card { background: #fff; border: 1px solid var(--cp-line); border-radius: 12px; padding: 24px; box-shadow: 0 1px 2px rgba(15,23,42,.04); }
        .cp-merchant { display: flex; align-items: center; gap: 12px; padding-bottom: 16px; border-bottom: 1px solid var(--cp-line); }
        .cp-merchant img { width: 44px; height: 44px; object-fit: contain; border-radius: 8px; border: 1px solid var(--cp-line); background: #fff; }
        .cp-merchant-dot { width: 44px; height: 44px; border-radius: 8px; background: var(--cp-merchant); }
        .cp-label { font-size: 12px; color: var(--cp-muted); text-transform: uppercase; letter-spacing: .06em; }
        .cp-amount { font-size: 32px; font-weight: 800; margin: 18px 0 4px; color: var(--cp-navy); }
        .cp-ref { font-size: 13px; color: var(--cp-muted); overflow-wrap: anywhere; }
        .cp-timer { margin-top: 18px; font-size: 13px; color: var(--cp-muted); }
        .cp-help { margin-top: 18px; padding-top: 14px; border-top: 1px dashed var(--cp-line); font-size: 12px; color: var(--cp-muted); line-height: 1.7; }
        .cp-help strong { color: var(--cp-navy); }
        h1 { font-size: 20px; margin: 0 0 16px; color: var(--cp-navy); }
        .cp-field { margin-bottom: 14px; }
        .cp-field label { display: block; font-size: 13px; font-weight: 600; margin-bottom: 6px; }
        .cp-field .cp-opt { font-weight: 400; color: var(--cp-muted); }
        .cp-field input { width: 100%; padding: 11px 12px; font-size: 15px; border: 1px solid #cbd5e1; border-radius: 8px; outline: none; font-family: inherit; }
        .cp-field input:focus { border-color: var(--cp-blue); box-shadow: 0 0 0 3px rgba(7,106,171,.15); }
        .cp-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
        .cp-btn { width: 100%; padding: 13px; font-size: 16px; font-weight: 700; color: #fff; background: var(--cp-blue); border: 0; border-radius: 8px; cursor: pointer; }
        .cp-btn:hover { filter: brightness(1.08); }
        .cp-btn[disabled] { opacity: .45; cursor: not-allowed; }
        .cp-btn-alt { background: var(--cp-red); width: auto; padding: 12px 16px; font-size: 15px; }
        .cp-cancel { display: block; text-align: center; margin-top: 14px; font-size: 14px; color: var(--cp-muted); }
        .cp-msg { border-radius: 8px; padding: 10px 12px; font-size: 14px; margin: 0 0 14px; background: #ecfdf5; color: #065f46; border: 1px solid #a7f3d0; }
        .cp-msg.cp-err { background: #fef2f2; color: #991b1b; border-color: #fecaca; }
        .cp-center { text-align: center; }
        .cp-spinner { width: 44px; height: 44px; margin: 10px auto 18px; border: 4px solid #dbeafe; border-top-color: var(--cp-blue); border-radius: 50%; animation: cp-spin .8s linear infinite; }
        @keyframes cp-spin { to { transform: rotate(360deg); } }
        .cp-main .ci-btn { background: var(--cp-blue); }
        .cp-main .ci-link { color: var(--cp-blue); }
        .cp-main .ci-field input:focus { border-color: var(--cp-blue); box-shadow: 0 0 0 3px rgba(7,106,171,.15); }
        .cp-main .ci-title { color: var(--cp-navy); }
        {% block styles %}{% endblock %}
        @media (max-width: 780px) { .cp-wrap { grid-template-columns: 1fr; margin: 16px auto; } }
    </style>
</head>
<body>
    <header class="cp-top">
        {% if brand.logo %}<img src="{{ brand.logo }}" alt="CourtPay">{% else %}<strong>CourtPay</strong>{% endif %}
        <div class="cp-tag">Payment Portal of the<br><strong>Judiciary of Trinidad and Tobago</strong></div>
    </header>
    <div class="cp-band" aria-hidden="true"></div>
    <div class="cp-hero"><strong>Pay Court Orders</strong> &middot; Traffic Tickets, Fixed Penalty Notices, Court Ordered Fines and Maintenance</div>
    <div class="cp-wrap">
        <aside class="cp-card">
            <div class="cp-merchant">
                {% if merchant.logo %}<img src="{{ merchant.logo }}" alt="">{% else %}<span class="cp-merchant-dot"></span>{% endif %}
                <div>
                    <div class="cp-label">Paying</div>
                    <strong>{{ merchant.name }}</strong>
                </div>
            </div>
            <div class="cp-amount">{{ currency }} {{ amount|number_format(2) }}</div>
            <div class="cp-ref">CourtPay reference {{ trx }}</div>
            <div class="cp-timer">Session expires in <span id="cp-timer" data-seconds="{{ expires_in }}">{{ (expires_in // 60) }} min</span></div>
            <div class="cp-help">
                CourtPay hotline: <strong>{{ brand.hotline }}</strong><br>
                Support: {{ brand.helpdesk }}
            </div>
        </aside>
        <main class="cp-card cp-main">
            {% block content %}{% endblock %}
        </main>
    </div>
    <script nonce="{{ nonce }}">
        (function () {
            var el = document.getElementById('cp-timer');
            if (!el) { return; }
            var left = parseInt(el.getAttribute('data-seconds'), 10) || 0;
            function tick() {
                var m = Math.floor(left / 60), s = left % 60;
                el.textContent = m + ':' + (s < 10 ? '0' : '') + s;
                if (left > 0) { left--; setTimeout(tick, 1000); }
            }
            tick();
        })();
    </script>
    {% block scripts %}{% endblock %}
</body>
</html>
