{% extends 'admin/layout/base.twig' %}
{% block title %}{{ code.id is defined and code.id ? 'Edit' : 'Create' }} Treasury Code - {{ app_name }}{% endblock %}
{% block content %}
<div class="op-page-header">
    <div>
        <h1>{{ code.id is defined and code.id ? 'Edit' : 'Create' }} Treasury Code</h1>
        <p class="op-page-subtitle">Format: Head (2) / Sub-Head (2) / Item (3) / Sub-Item (2), e.g. 18/02/001/01. Label is built from the tier names.</p>
    </div>
    <a href="/admin/treasury-codes" class="op-btn op-btn-outline">← Back</a>
</div>

<form method="POST" action="/admin/treasury-codes/{{ code.id is defined and code.id ? code.id ~ '/edit' : 'create' }}" class="op-form" id="treasury-code-form">
    <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">
    <div class="op-card">
        <div class="op-card-body">
            <div class="op-form-row">
                <div class="op-form-group op-col-3">
                    <label>Head *</label>
                    <input type="text" name="head" value="{{ code.head ?? '' }}" class="op-input" maxlength="2" required pattern="[0-9A-Za-z]{2}" placeholder="18">
                    <input type="text" name="head_name" value="{{ code.head_name ?? '' }}" class="op-input op-mt-2" required maxlength="255" placeholder="Ministry of Finance">
                </div>
                <div class="op-form-group op-col-3">
                    <label>Sub-Head *</label>
                    <input type="text" name="sub_head" value="{{ code.sub_head ?? '' }}" class="op-input" maxlength="2" required pattern="[0-9]{1,2}" placeholder="02">
                    <input type="text" name="sub_head_name" value="{{ code.sub_head_name ?? '' }}" class="op-input op-mt-2" required maxlength="255" placeholder="Goods and Services">
                </div>
                <div class="op-form-group op-col-3">
                    <label>Item *</label>
                    <input type="text" name="item" value="{{ code.item ?? '' }}" class="op-input" maxlength="3" required pattern="[0-9]{1,3}" placeholder="001">
                    <input type="text" name="item_name" value="{{ code.item_name ?? '' }}" class="op-input op-mt-2" required maxlength="255" placeholder="General Administration">
                </div>
                <div class="op-form-group op-col-3">
                    <label>Sub-Item *</label>
                    <input type="text" name="sub_item" value="{{ code.sub_item ?? '' }}" class="op-input" maxlength="2" required pattern="[0-9]{1,2}" placeholder="01">
                    <input type="text" name="sub_item_name" value="{{ code.sub_item_name ?? '' }}" class="op-input op-mt-2" required maxlength="255" placeholder="Travelling and Subsistence">
                </div>
            </div>
            <div class="op-form-group">
                <label>Label (auto)</label>
                <input type="text" id="treasury_label_preview" class="op-input" readonly
                       value="{{ code.label ?? '' }}"
                       placeholder="Built from tier names">
            </div>
            <div class="op-form-group">
                <label>Status</label>
                <select name="status" class="op-input">
                    <option value="active" {{ (code.status ?? 'active') == 'active' ? 'selected' : '' }}>Active</option>
                    <option value="inactive" {{ (code.status ?? '') == 'inactive' ? 'selected' : '' }}>Inactive</option>
                </select>
            </div>
        </div>
    </div>
    <div class="op-form-actions op-mt-4">
        <button type="submit" class="op-btn op-btn-primary op-btn-lg">Save</button>
    </div>
</form>
<script>
(function () {
    var form = document.getElementById('treasury-code-form');
    if (!form) return;
    var preview = document.getElementById('treasury_label_preview');
    var fields = ['head_name', 'sub_head_name', 'item_name', 'sub_item_name'];
    function refresh() {
        var parts = fields.map(function (n) {
            var el = form.querySelector('[name="' + n + '"]');
            return el ? el.value.trim() : '';
        }).filter(Boolean);
        preview.value = parts.join(' / ');
    }
    fields.forEach(function (n) {
        var el = form.querySelector('[name="' + n + '"]');
        if (el) el.addEventListener('input', refresh);
    });
    refresh();
})();
</script>
{% endblock %}
