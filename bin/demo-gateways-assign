#!/usr/bin/env php
<?php
declare(strict_types=1);

/**
 * Makes the DemoPay and VoucherPay demo gateways the only active gateways on every brand.
 *
 * Usage: php bin/demo-gateways-assign [--dry-run] [--revert]
 *
 * For each row in op_merchants: activates both plugins for the brand, stores their encrypted
 * credentials (existing values are kept), and deactivates every other active API gateway,
 * recording it in storage/demo-gateways-replaced.json. --revert restores the recorded
 * gateways and deactivates both demo gateways. Voucher data is never touched.
 */

if (PHP_SAPI !== 'cli') {
    fwrite(STDERR, "This script must be run from the command line.\n");
    exit(1);
}

$root = dirname(__DIR__);
chdir($root);
require $root . '/vendor/autoload.php';
require_once $root . '/modules/gateways/npictt-voucher/VoucherBalanceChanged.php';
require_once $root . '/modules/gateways/npictt-voucher/VoucherStore.php';

use OwnPay\Core\Database;
use OwnPay\Modules\Gateways\Voucherpay\VoucherStore;
use OwnPay\Plugin\PluginManager;
use OwnPay\Repository\GatewayConfigRepository;
use OwnPay\Repository\GatewayRepository;
use OwnPay\Security\FieldEncryptor;

$opts = getopt('', ['dry-run', 'revert', 'help']);
if (isset($opts['help'])) {
    echo "Usage: php bin/demo-gateways-assign [--dry-run] [--revert]\n";
    exit(0);
}
$dryRun = isset($opts['dry-run']);
$revert = isset($opts['revert']);
$recordFile = $root . '/storage/demo-gateways-replaced.json';
$demoSlugs = ['npictt-card', 'npictt-voucher'];

if (!file_exists($root . '/storage/.installed')) {
    fwrite(STDERR, "OwnPay is not installed yet. Run the installer first.\n");
    exit(1);
}

Dotenv\Dotenv::createImmutable($root)->safeLoad();
$c = new OwnPay\Container();
$c->instance(OwnPay\Container::class, $c);
(require $root . '/config/services.php')($c);

$db        = $c->get(Database::class);
$plugins   = $c->get(PluginManager::class);
$gateways  = $c->get(GatewayRepository::class);
$configs   = $c->get(GatewayConfigRepository::class);
$encryptor = $c->get(FieldEncryptor::class);
if (!$db instanceof Database || !$plugins instanceof PluginManager || !$gateways instanceof GatewayRepository
    || !$configs instanceof GatewayConfigRepository || !$encryptor instanceof FieldEncryptor) {
    fwrite(STDERR, "Failed to resolve OwnPay services.\n");
    exit(1);
}

$record = is_file($recordFile) ? json_decode((string) file_get_contents($recordFile), true) : null;
$record = is_array($record) ? $record : [];
$merchants = $db->fetchAll('SELECT id, slug, name FROM op_merchants ORDER BY id');

/**
 * Returns the brand's own config row for a gateway slug (never the global fallback row).
 *
 * @return array<string, mixed>|null
 */
$brandConfig = static function (int $mid, string $slug) use ($db): ?array {
    return $db->fetchOne(
        'SELECT gc.* FROM op_gateway_configs gc JOIN op_gateways g ON g.id = gc.gateway_id
         WHERE gc.merchant_id = :mid AND g.slug = :slug LIMIT 1',
        ['mid' => $mid, 'slug' => $slug]
    );
};

/**
 * @return array<string, string>
 */
$defaultsFor = static function (string $slug): array {
    return $slug === 'npictt-card'
        ? [
            'demo_enabled'     => 'yes',
            'publishable_key'  => 'pk_live_' . bin2hex(random_bytes(12)),
            'secret_key'       => 'sk_live_' . bin2hex(random_bytes(24)),
            'checkout_label'   => 'Credit/Debit Card',
            'three_ds'         => 'test_cards',
            'processing_delay' => '2',
        ]
        : ['checkout_label' => 'Prepaid Voucher'];
};

$fail = static function (string $message): never {
    fwrite(STDERR, "Error: {$message}\n");
    exit(1);
};

if ($revert) {
    echo ($dryRun ? '[dry-run] ' : '') . "Reverting demo gateways on " . count($merchants) . " brand(s)\n";
    foreach ($merchants as $m) {
        $mid = (int) $m['id'];
        $restore = is_array($record[(string) $mid] ?? null) ? $record[(string) $mid] : [];
        if (!$dryRun) {
            foreach ($restore as $slug) {
                $res = $plugins->activate((string) $slug, $mid);
                if (!$res['success']) {
                    $fail("could not re-activate {$slug} for brand #{$mid}: " . ($res['error'] ?? 'unknown error'));
                }
            }
            foreach ($demoSlugs as $slug) {
                $plugins->deactivate($slug, $mid);
            }
        }
        printf("  #%-3d %-14s restored: %s\n", $mid, $m['slug'], $restore === [] ? '-' : implode(', ', $restore));
    }
    if (!$dryRun && is_file($recordFile)) {
        unlink($recordFile);
    }
    echo $dryRun ? "Dry run complete. No changes were written.\n" : "Done.\n";
    exit(0);
}

echo ($dryRun ? '[dry-run] ' : '') . "Assigning DemoPay + VoucherPay to " . count($merchants) . " brand(s)\n";
if (!$dryRun) {
    (new VoucherStore($db))->ensureSchema();
}
foreach ($merchants as $m) {
    $mid = (int) $m['id'];

    $others = [];
    foreach ($configs->forTenant($mid)->listActiveForCheckout() as $row) {
        $slug = (string) ($row['slug'] ?? '');
        if ($slug !== '' && !in_array($slug, $demoSlugs, true)) {
            $others[] = $slug;
        }
    }

    if (!$dryRun) {
        foreach ($demoSlugs as $slug) {
            $res = $plugins->activate($slug, $mid);
            if (!$res['success']) {
                $fail("could not activate {$slug} for brand #{$mid}: " . ($res['error'] ?? 'unknown error'));
            }

            $gw = $gateways->findBySlug($slug);
            $gwId = is_numeric($gw['id'] ?? null) ? (int) $gw['id'] : 0;
            if ($gwId === 0) {
                $fail("gateway row for {$slug} is missing after activation");
            }

            $existing = $brandConfig($mid, $slug);
            $current = [];
            if (is_string($existing['credentials_enc'] ?? null) && $existing['credentials_enc'] !== '') {
                $decoded = json_decode($encryptor->decrypt($existing['credentials_enc']), true);
                $current = is_array($decoded) ? array_filter($decoded, static fn($v): bool => $v !== '' && $v !== null
                    && !str_starts_with((string) $v, 'pk_demo_') && !str_starts_with((string) $v, 'sk_demo_')) : [];
            }
            $creds = array_merge($defaultsFor($slug), $current);
            if ($slug === 'npictt-card') {
                $creds['demo_enabled'] = 'yes';
            }
            $fields = ['credentials_enc' => $encryptor->encrypt((string) json_encode($creds)), 'status' => 'active', 'mode' => 'live'];

            $scoped = $configs->forTenant($mid);
            if ($existing !== null) {
                $scoped->updateScoped((int) $existing['id'], $fields);
            } else {
                $scoped->createScoped($fields + ['merchant_id' => $mid, 'gateway_id' => $gwId]);
            }
        }

        foreach ($others as $slug) {
            $own = $brandConfig($mid, $slug);
            if ($own === null) {
                echo "  warning: {$slug} is active for brand #{$mid} through a platform-wide config; left unchanged\n";
                continue;
            }
            $res = $plugins->deactivate($slug, $mid);
            if (!$res['success']) {
                $configs->forTenant($mid)->updateScoped((int) $own['id'], ['status' => 'inactive']);
            }
        }

        $record[(string) $mid] = array_values(array_unique(array_merge(
            is_array($record[(string) $mid] ?? null) ? $record[(string) $mid] : [],
            $others
        )));
    }

    printf("  #%-3d %-14s demopay + voucherpay active; replaced: %s\n", $mid, $m['slug'], $others === [] ? '-' : implode(', ', $others));
}

if (!$dryRun) {
    file_put_contents($recordFile, json_encode($record, JSON_PRETTY_PRINT) . "\n");
    echo "Recorded replaced gateways in storage/demo-gateways-replaced.json\n";
}
echo $dryRun ? "Dry run complete. No changes were written.\n" : "Done. Seed vouchers with: php bin/voucherpay-seed\n";
