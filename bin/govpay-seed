#!/usr/bin/env php
<?php
declare(strict_types=1);

/**
 * Seeds demo codes for the GovPay and CourtPay gateways.
 *
 * Usage: php bin/govpay-seed [--count=N --amount=X --currency=TTD] [--dry-run]
 *
 * Always creates (or resets) the fixed GovPay voucher, SMS and QR codes and CourtPay Top-up
 * Vouchers listed below. With --count, also issues that many random codes per channel.
 * Creates the GovPay and CourtPay tables if missing. GovPay wallets open automatically with
 * the gateway's "Demo wallet opening balance" the first time a payer uses them.
 */

if (PHP_SAPI !== 'cli') {
    fwrite(STDERR, "This script must be run from the command line.\n");
    exit(1);
}

$root = dirname(__DIR__);
chdir($root);
require $root . '/vendor/autoload.php';

use OwnPay\Gateway\Demo\PrepaidCodeStore;

$opts = getopt('', ['count:', 'amount:', 'currency:', 'dry-run', 'help']);
if (isset($opts['help'])) {
    echo "Usage: php bin/govpay-seed [--count=N --amount=X --currency=TTD] [--dry-run]\n";
    exit(0);
}
$dryRun   = isset($opts['dry-run']);
$count    = isset($opts['count']) && is_string($opts['count']) ? (int) $opts['count'] : 0;
$amount   = isset($opts['amount']) && is_string($opts['amount']) ? $opts['amount'] : '100';
$currency = strtoupper(isset($opts['currency']) && is_string($opts['currency']) ? $opts['currency'] : 'TTD');

if ($count < 0 || $count > 500 || !preg_match('/^\d{1,10}(\.\d{1,2})?$/', $amount) || !preg_match('/^[A-Z]{3}$/', $currency)) {
    fwrite(STDERR, "Invalid --count (0-500), --amount or --currency.\n");
    exit(1);
}

if (!file_exists($root . '/storage/.installed')) {
    fwrite(STDERR, "OwnPay is not installed yet. Run the installer first.\n");
    exit(1);
}

Dotenv\Dotenv::createImmutable($root)->safeLoad();
$c = new OwnPay\Container();
$c->instance(OwnPay\Container::class, $c);
(require $root . '/config/services.php')($c);

$db = $c->get(OwnPay\Core\Database::class);
if (!$db instanceof OwnPay\Core\Database) {
    fwrite(STDERR, "Failed to resolve the database.\n");
    exit(1);
}

$expired = date('Y-m-d H:i:s', strtotime('-1 day'));
$pools = [
    'GovPay' => [
        'schema' => $root . '/modules/gateways/govpay/schema.sql',
        'prefix' => 'op_plugin_govpay',
        'random' => [['voucher', 'GOV'], ['sms', 'SMS'], ['qr', 'QR']],
        'fixed'  => [
            ['GOV-VCH-1000', '1000.00', 'voucher', null],
            ['GOV-VCH-0100', '100.00', 'voucher', null],
            ['GOV-SMS-0500', '500.00', 'sms', null],
            ['GOV-QR-0250', '250.00', 'qr', null],
            ['GOV-EXPIRED', '100.00', 'voucher', $expired],
        ],
    ],
    'CourtPay' => [
        'schema' => $root . '/modules/gateways/courtpay/schema.sql',
        'prefix' => 'op_plugin_courtpay',
        'random' => [['voucher', 'CP']],
        'fixed'  => [
            ['CP-TOPUP-1000', '1000.00', 'voucher', null],
            ['CP-TOPUP-0200', '200.00', 'voucher', null],
            ['CP-TOPUP-0050', '50.00', 'voucher', null],
            ['CP-EXPIRED', '100.00', 'voucher', $expired],
        ],
    ],
];

foreach ($pools as $name => $pool) {
    $store = new PrepaidCodeStore($db, $pool['prefix']);
    if (!$dryRun) {
        PrepaidCodeStore::ensureSchema($db, $pool['schema']);
    }
    echo ($dryRun ? '[dry-run] ' : '') . "Seeding {$name} demo codes\n";
    foreach ($pool['fixed'] as [$code, $value, $channel, $expires]) {
        if (!$dryRun) {
            $store->upsert($code, 'TTD', $value, $expires, $channel);
        }
        printf("  %-16s %-8s TTD %10s%s\n", $code, $channel, $value, $expires !== null ? '  (expired)' : '');
    }
    if ($count > 0) {
        $value = bcadd($amount, '0', 2);
        foreach ($pool['random'] as [$channel, $codePrefix]) {
            $codes = $dryRun ? array_fill(0, $count, '(random)') : $store->issue($count, $currency, $value, $channel, $codePrefix);
            foreach ($codes as $code) {
                printf("  %-16s %-8s %s %10s\n", $code, $channel, $currency, $value);
            }
        }
    }
}

echo $dryRun ? "Dry run complete. No changes were written.\n" : "Done.\n";
